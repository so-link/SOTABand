resources/workflows/hypoxemia/runtime/vendor/** text eol=lf
requirements/*.lock text eol=lf
* text=auto

# Linux 部署脚本必须 LF，否则 sh 会报 "$'\r': command not found"
*.sh            text eol=lf
*.service.tpl   text eol=lf
*.tpl           text eol=lf
*.env           text eol=lf

# Python / 前端源码统一 LF
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.css           text eol=lf
*.html          text eol=lf

# PowerShell 用 CRLF
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf
