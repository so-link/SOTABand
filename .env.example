# SOTABand Engine 配置文件
# 复制此文件为 .env 并填入实际值
#
# ═══════════════════════════════════════════════════════════════
# LLM 服务商配置（OpenAI 兼容协议）
# ═══════════════════════════════════════════════════════════════
# 统一写法，切换服务商只改两行：
#
#   LLM_PROVIDER=<服务商名>      # 见下方列表
#   LLM_API_KEY=<该服务的key>    # 所有服务商的 key 都填这个变量，不用记专属名
#
# 可选覆盖（不填则用该服务商预设的默认端点/模型）：
#   LLM_BASE_URL=<服务商 API 地址>
#   LLM_MODEL=<模型名>
#
# 旧式专属变量（如 DEEPSEEK_API_KEY / MOONSHOT_API_KEY ...）仍然兼容，
# 但推荐统一使用上面的写法，切换服务商时无需记不同变量名。
#
# 支持的 provider 及预设默认端点 / 模型：
#
# ── MiMo Coding Plan（小米订阅，套餐自带 API，无需额外付费）────
#   key 以 tp- 开头；Token Plan 覆盖 V2.5 系列模型
#   LLM_PROVIDER=mimo
#   LLM_API_KEY=tp-xxxxxxxxxxxxxxxx
#   # 模型必填，按需选择：
#   #   MiMo-V2.5     标准版
#   #   MiMo-V2.5-Pro 旗舰版（1T 参数，Agent 场景更强）
#   LLM_MODEL=MiMo-V2.5
#   # LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
#
# ── DeepSeek（默认）────────────────────────────────────────────
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.deepseek.com/v1
#   # LLM_MODEL=deepseek-v4-pro
#
# ── OpenAI ─────────────────────────────────────────────────────
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.openai.com/v1
#   # LLM_MODEL=gpt-4o
#
# ── Kimi (Moonshot) ────────────────────────────────────────────
#   LLM_PROVIDER=moonshot
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.moonshot.cn/v1
#   # LLM_MODEL=kimi-k2
#
# ── 智谱 GLM ───────────────────────────────────────────────────
#   LLM_PROVIDER=zhipu
#   LLM_API_KEY=xxxxxxxx.xxxxxxxx
#   # LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   # LLM_MODEL=glm-4-plus
#
# ── 通义千问 (阿里云百炼) ──────────────────────────────────────
#   LLM_PROVIDER=qwen
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   # LLM_MODEL=qwen-plus
#
# ── 硅基流动 ───────────────────────────────────────────────────
#   LLM_PROVIDER=siliconflow
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.siliconflow.cn/v1
#   # LLM_MODEL=deepseek-ai/DeepSeek-V3
#
# ── MiniMax ────────────────────────────────────────────────────
#   LLM_PROVIDER=minimax
#   LLM_API_KEY=xxxxxxxx
#   # LLM_BASE_URL=https://api.minimaxi.com/v1
#   # LLM_MODEL=MiniMax-Text-01
#
# ── 豆包 (火山方舟) ────────────────────────────────────────────
#   LLM_PROVIDER=doubao
#   LLM_API_KEY=xxxxxxxx
#   # LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   # LLM_MODEL=doubao-pro-32k
#
# ── 其他任意 OpenAI 兼容服务（自建网关 / 聚合平台）─────────────
#   LLM_PROVIDER=mygw                  # 自定义名（小写）
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_BASE_URL=https://你的网关地址/v1   # 必填（无预设默认值）
#   LLM_MODEL=你的模型名

# 服务配置
# SOTABAND_API_HOST=0.0.0.0
# SOTABAND_API_PORT=8000
