# SOTABand Engine 配置文件
# 复制此文件为 .env 并填入实际值
#
# ═══════════════════════════════════════════════════════════════
# LLM 服务商配置（OpenAI 兼容协议）
# ═══════════════════════════════════════════════════════════════
# 统一写法，切换服务商只改两行：
#
#   LLM_PROVIDER=<服务商名>      # 见下方列表
#   LLM_API_KEY=<该服务的key>    # 所有服务商的 key 都填这个变量，不用记专属名
#
# 可选覆盖（不填则用该服务商预设的默认端点/模型）：
#   LLM_BASE_URL=<服务商 API 地址>
#   LLM_MODEL=<模型名>
#
# ── 主 key 与 副 key ────────────────────────────────────────────
#   主 key：LLM_PROVIDER 指向的那家（LLM_API_KEY），Agent 对话与
#           普通工具的默认选择。
#   副 key：以 <PROVIDER>_API_KEY 形式存放的其他厂商 key，例如
#           DEEPSEEK_API_KEY / DOUBAO_API_KEY / MIMO_API_KEY ...
#           它们安静躺着，工具调用【LLM自定义配置对话API】时只传
#           provider 即可自动取用，密钥无需出现在聊天或工具代码里。
#   示例：主用 MiMo 看图，副配 DeepSeek 写文本：
#     LLM_PROVIDER=mimo
#     LLM_API_KEY=sk-xxx
#     DEEPSEEK_API_KEY=sk-yyy
# 旧式专属变量（如 DEEPSEEK_API_KEY / MOONSHOT_API_KEY ...）仍然兼容，
# 但推荐统一使用上面的写法，切换服务商时无需记不同变量名。
#
# ⚠️ 同一厂商可能有「多套端点 + 多套 Key」，且互不通用
# （典型：小米 MiMo 按量付费是 sk- → api.xiaomimimo.com，
#   Token Plan 订阅是 tp- → token-plan-cn.xiaomimimo.com，官方声明不可混用）
# 系统已按 Key 前缀自动选择端点，因此正常情况下**不需要**手填 LLM_BASE_URL。
# 只有当厂商的两套 Key 前缀相同、无法区分时才需显式指定（见下方各厂商说明）。
#
# 支持的 provider 及预设默认端点 / 模型：
#
# ── MiMo（小米）──── 两套方案，端点按 Key 前缀自动选择 ──────────
#   ① 按量付费（默认）：key 以 sk- 开头 → https://api.xiaomimimo.com/v1
#     LLM_PROVIDER=mimo
#     LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   ② Token Plan 订阅：key 以 tp- 开头 → https://token-plan-cn.xiaomimimo.com/v1
#     LLM_PROVIDER=mimo
#     LLM_API_KEY=tp-xxxxxxxxxxxxxxxx
#   # 模型按需选择（大小写均可）：
#   #   mimo-v2.5     标准版
#   #   mimo-v2.5-pro 旗舰版（1T 参数，Agent 场景更强）
#   LLM_MODEL=mimo-v2.5
#   # 仅在你想强制指定端点时才写：
#   # LLM_BASE_URL=https://api.xiaomimimo.com/v1
#   # 官方文档：https://mimo.mi.com/docs/zh-CN/quick-start/summary/first-api-call
#
# ── DeepSeek（默认）────────────────────────────────────────────
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.deepseek.com/v1
#   # LLM_MODEL=deepseek-v4-pro
#
# ── OpenAI ─────────────────────────────────────────────────────
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.openai.com/v1
#   # LLM_MODEL=gpt-4o
#
# ── Kimi (Moonshot) ────────────────────────────────────────────
#   ⚠️ 中国站与国际站是两套独立账号，Key 不通用，但前缀同为 sk-，
#      系统无法自动区分 → 国际站用户必须显式指定端点：
#   LLM_PROVIDER=moonshot
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.moonshot.cn/v1   # 中国站（默认）
#   # LLM_BASE_URL=https://api.moonshot.ai/v1   # 国际站
#   # LLM_MODEL=kimi-k2
#
# ── 智谱 GLM ───────────────────────────────────────────────────
#   ⚠️ GLM Coding Plan 套餐 Key 与开放平台通用 Key 不通用，端点也不同；
#      两者 Key 格式同为 {id}.{secret}，无法按前缀区分 → 需显式指定端点：
#   LLM_PROVIDER=zhipu
#   LLM_API_KEY=xxxxxxxx.xxxxxxxx
#   # LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4          # 开放平台通用（默认）
#   # LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4   # GLM Coding Plan 套餐
#   # LLM_MODEL=glm-4-plus
#
# ── 通义千问 (阿里云百炼) ──────────────────────────────────────
#   ⚠️ 中国大陆版与国际版账号独立，Key 前缀同为 sk-，无法自动区分：
#   LLM_PROVIDER=qwen
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1       # 中国大陆版（默认）
#   # LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  # 国际版
#   # LLM_MODEL=qwen-plus
#
# ── 硅基流动 ───────────────────────────────────────────────────
#   LLM_PROVIDER=siliconflow
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   # LLM_BASE_URL=https://api.siliconflow.cn/v1
#   # LLM_MODEL=deepseek-ai/DeepSeek-V3
#
# ── MiniMax ────────────────────────────────────────────────────
#   ⚠️ 中国版与全球版账号独立，无法自动区分：
#   LLM_PROVIDER=minimax
#   LLM_API_KEY=xxxxxxxx
#   # LLM_BASE_URL=https://api.minimaxi.com/v1   # 中国版（默认）
#   # LLM_BASE_URL=https://api.minimax.io/v1     # 全球版
#   # LLM_MODEL=MiniMax-Text-01
#
# ── 豆包 (火山方舟) ────────────────────────────────────────────
#   LLM_PROVIDER=doubao
#   LLM_API_KEY=xxxxxxxx
#   # LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   # LLM_MODEL=doubao-pro-32k
#
# ── 其他任意 OpenAI 兼容服务（自建网关 / 聚合平台）─────────────
#   LLM_PROVIDER=mygw                  # 自定义名（小写）
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_BASE_URL=https://你的网关地址/v1   # 必填（无预设默认值）
#   LLM_MODEL=你的模型名

# 服务配置
# （已废弃）SOTABAND_API_HOST=0.0.0.0
# SOTABAND_API_PORT=8000
# Built-in computation uses .venv-hypoxemia created by scripts/install_hypoxemia.ps1.
# Optional override for an administrator-managed interpreter; no external source project.
SOTABAND_HYPOXEMIA_PYTHON=
# Optional runtime directory (defaults to .runtime/refactor).
SOTABAND_RUNTIME_ROOT=
# Trusted local roots containing approved window pickle files (semicolon-separated on Windows).
SPO2_HYPOXEMIA_TRUSTED_DATA_ROOTS=

# ═══════════════════════════════════════════════════════════════
# 数据库与存储（需求 8.1/8.2）
# ═══════════════════════════════════════════════════════════════
# 开发默认 SQLite（零配置）；生产可换 PostgreSQL（需 pip install -e ".[postgres]"）
# DATABASE_URL=sqlite+aiosqlite:///./storage/sotaband.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/sotaband
# STORAGE_BACKEND=sqlite

# ═══════════════════════════════════════════════════════════════
# 会话与认证（需求 8.1）
# ═══════════════════════════════════════════════════════════════
# SOTABAND_SESSION_COOKIE=sotaband_session
# SOTABAND_COOKIE_SECURE=0            # 生产 https 环境必须置 1，否则 Cookie 可被明文传输
# SOTABAND_COOKIE_SAMESITE=lax        # 挡住绝大多数跨站写请求（CSRF）
# SOTABAND_SESSION_TTL_DAYS=30
# SOTABAND_BCRYPT_ROUNDS=12           # 需在目标机器实测标定（约 250ms/次）
# 登录限流（账号维度防定向爆破，IP 维度防 spraying）
# SOTABAND_LOGIN_MAX_ATTEMPTS=5
# SOTABAND_LOGIN_WINDOW_SECONDS=300
# SOTABAND_LOGIN_LOCK_SECONDS=900
# SOTABAND_LOGIN_IP_MAX=20
# SOTABAND_LOGIN_IP_WINDOW=300
# SOTABAND_REGISTER_MAX_PER_HOUR=5
# 密码策略（字母+数字，8-20 位）
# SOTABAND_PASSWORD_MIN_LENGTH=8
# SOTABAND_PASSWORD_MAX_LENGTH=20
# SOTABAND_PASSWORD_CHANGE_MAX_FAILURES=5
# SOTABAND_PASSWORD_CHANGE_WINDOW=3600
#
# ── 平台管理员（部署级、跨租户）──────────────────────────────
# 逗号分隔的 users.id（UUID）。**空 = 没有人是平台管理员（fail-closed）**。
# 带横线（fe8bf88d-f60c-…）或不带横线（从 SQLite user.id 直接复制的 32 位 hex）
# 都可以，大小写不敏感。
# 只有平台管理员可以：修改/读取全局 LLM 配置、测试 LLM 连接、
# 查看他人数据集（include_others）、认领历史无主数据集。
# ⚠️ 不要把它当作"租户 Owner"：任何自助注册用户都是自己个人租户的 owner。
# SOTABAND_PLATFORM_ADMINS=

# ═══════════════════════════════════════════════════════════════
# 工作负载身份（需求 8.2，生产必填）
# ═══════════════════════════════════════════════════════════════
# ⚠️ 生产环境必须显式配置 SOTABAND_WORKLOAD_SECRET：
#    未配置时进程启动随机生成，重启后所有 Agent 工作负载凭证失效，多 worker 互不认。
# SOTABAND_WORKLOAD_SECRET=请替换为足够长的随机串
# SOTABAND_WORKLOAD_TTL=600
# SOTABAND_INVOKE_MAX_PER_WINDOW=120
# SOTABAND_INVOKE_WINDOW=60
# 网络 Agent 调用投递等待超时（秒）
# SOTABAND_INVOKE_DELIVERY_TIMEOUT=5

# ═══════════════════════════════════════════════════════════════
# 跨域 / 端口
# ═══════════════════════════════════════════════════════════════
# 必须是显式来源列表（浏览器规范：allow_credentials 与 * 不能共存）
# SOTABAND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001
# SOTABAND_API_PORT=8001

# ═══════════════════════════════════════════════════════════════
# 文件访问边界（多用户服务器部署必须了解）
# ═══════════════════════════════════════════════════════════════
# 工作区间「打开目录 / 预览 / 下载 / 删除」默认只允许：
#   项目根、.runtime/refactor、resources-private、上传目录、已注册数据集目录。
# 需要额外允许的目录用下面变量扩展（Windows 用 ; 分隔）：
# SOTABAND_FILE_ALLOWED_ROOTS=
# 单文件上传大小上限（MB）
# SOTABAND_UPLOAD_MAX_MB=512
# LLM 连通性测试默认禁止访问 localhost/内网（防 SSRF）。
# 本机 Ollama 等场景需要测试回环地址时置 1：
# SOTABAND_LLM_ALLOW_LOCAL=0
# 跳过 .env 自动加载（容器/CI 显式注入环境变量时置 0）
# SOTABAND_LOAD_DOTENV=1

# ═══════════════════════════════════════════════════════════════
# 其它可覆盖项（评审补充）
# ═══════════════════════════════════════════════════════════════
# LLM 单次调用超时（秒）
# LLM_TIMEOUT=300
# 私有资源根目录（默认 <项目根>/resources-private）
# SOTABAND_PRIVATE_RESOURCES=
# runtime 各目录（默认都在 .runtime/refactor 下）
# SOTABAND_RUNTIME_ROOT=
# SOTABAND_LOGS_DIR=
# SOTABAND_TEMP_DIR=
# SOTABAND_PROCESSED_DATA_DIR=
# SOTABAND_TIMESERIES_RUNS_DIR=
